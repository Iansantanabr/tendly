# /etc/tendly/backup.env  --  owner root, mode 0600. Read by tendly-backup.service.
# Optional: without this file the backup stays on the VPS, 14 days of folders
# in ~/backups/tendly. Plain KEY=value lines.

# Days of dated folders kept on the VPS.
#TENDLY_BACKUP_KEEP_DAYS=14

# A copy off the machine with restic (encrypted, deduplicated). Any backend
# restic knows: another server over SFTP, Backblaze B2, S3, a REST server.
# Run "restic init" once with these same settings before the first backup.
#RESTIC_REPOSITORY=sftp:backup@backup.example.com:/srv/restic/tendly
#RESTIC_PASSWORD_FILE=/etc/tendly/restic-password
#TENDLY_RESTIC_KEEP_DAILY=14
#TENDLY_RESTIC_KEEP_WEEKLY=8

# Backblaze B2 instead:
#RESTIC_REPOSITORY=b2:bucket-name:tendly
#B2_ACCOUNT_ID=
#B2_ACCOUNT_KEY=
