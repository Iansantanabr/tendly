# /etc/tendly/tendly.env  --  owner root, mode 0600. Read by tendly.service.
# Plain KEY=value lines: no "export", no quotes, no spaces around "=".
# This file holds the access token: it never goes into the repository.

# Only this machine reaches Tendly directly; Caddy is the way in.
TENDLY_ADDR=127.0.0.1:28789

# The access token everyone must present. REQUIRED: behind a proxy every
# request looks local, and without a token "local" needs no sign-in at all.
# Generate one with:  openssl rand -hex 32
TENDLY_TOKEN=

# The app's own address (the one in the Caddyfile). Only this one: the address
# of published pages is set in Settings -> Addresses and time zone and is
# answered for under /p/ only.
TENDLY_ALLOWED_ORIGINS=https://app.example.com

# The address other machines reach this one at (pairing the Mac with the VPS).
TENDLY_PUBLIC_URL=https://app.example.com

# Who the push services (Apple, Google, Mozilla) may write to about this
# server's notifications. A real mailbox of yours.
TENDLY_PUSH_SUBJECT=mailto:you@example.com
